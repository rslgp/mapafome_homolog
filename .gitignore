
# Claude Code local state — per-machine, never committed
/.claude/

# Vercel deploy driver — local Playwright Chrome profile + built export artifacts
/export/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# LLM brain (local knowledge base) + multi-agent ideation boards — local only, not history
/LLM_BRAIN
/LLM_BRAIN*
/brainstorm/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright e2e — generated artifacts (report, traces, screenshots, videos)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
