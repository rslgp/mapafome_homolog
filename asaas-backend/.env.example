# ── Asaas backend env (SERVER-ONLY — never commit the filled-in .env) ─────────
# Copy to .env.local for local dev, and set these in the Vercel/Netlify
# dashboard for the deploy. NONE of these are NEXT_PUBLIC_* — they must never
# reach a browser bundle.

# Asaas API key. Get it from the Asaas dashboard:
#   Sandbox:    https://sandbox.asaas.com  -> Configurações -> Integrações -> Chave de API
#   Production: https://www.asaas.com       -> same path
# Start with the SANDBOX key. Only switch to production after end-to-end testing.
ASAAS_API_KEY=

# Which Asaas environment the key belongs to: sandbox | production
ASAAS_ENV=sandbox

# Static token you invent and register on the Asaas webhook (Configurações ->
# Webhooks -> "Token de autenticação"). Asaas echoes it back in the
# `asaas-access-token` header on every webhook POST; we verify it constant-time.
# Generate a long random value, e.g.: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Comma-separated browser origins allowed to call this backend (CORS).
# Defaults to https://mapafome.com.br,http://localhost:3000 if unset.
ALLOWED_ORIGINS=https://mapafome.com.br,http://localhost:3000
