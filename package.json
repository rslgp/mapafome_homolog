{
  "name": "mapafome",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://mapafome.com.br",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fitness": "node scripts/fitness-functions.mjs",
    "a11y": "npx --yes @axe-core/cli http://localhost:3000 --exit --tags wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22aa --show-errors",
    "export": "next build",
    "predeploy": "npm run build && node -e \"const fs=require('fs');['CNAME','.nojekyll'].forEach(f=>{if(!fs.existsSync('out/'+f)){console.error('[deploy] out/'+f+' missing — check public/'+f);process.exit(1)}});console.log('[deploy] out/CNAME + out/.nojekyll OK')\"",
    "deploy": "gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.9",
    "aes-encryption": "^1.0.4",
    "google-spreadsheet": "^3.0.10",
    "javascript-time-ago": "^2.5.12",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.2.2",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "twemoji": "^14.0.2",
    "universal-cookie": "^8.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@vitest/coverage-v8": "^2.1.8",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.9",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  }
}
