{
  "name": "mapafome",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://mapafome.com.br",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/stamp-sw-version.mjs",
    "build": "next build --webpack",
    "start": "npm run build && npx serve@latest out",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fitness": "node scripts/fitness-functions.mjs",
    "drill:rollback": "node scripts/rollback-drill.mjs",
    "smoke200": "node scripts/smoke200.mjs",
    "a11y": "npx --yes @axe-core/cli http://localhost:3000 --exit --tags wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22aa --show-errors",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "export": "next build",
    "predeploy": "npm run build && node -e \"const fs=require('fs');['CNAME','.nojekyll'].forEach(f=>{if(!fs.existsSync('out/'+f)){console.error('[deploy] out/'+f+' missing — check public/'+f);process.exit(1)}});console.log('[deploy] out/CNAME + out/.nojekyll OK')\"",
    "deploy": "gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.0.0",
    "aes-encryption": "^1.0.4",
    "google-spreadsheet": "3.0.10",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.24",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.0",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
